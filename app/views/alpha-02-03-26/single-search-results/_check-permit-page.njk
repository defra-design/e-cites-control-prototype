{# Generated by Cursor - shared content for permit pages #}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    <span class="govuk-caption-l">Check permit details</span>
    <div class="govuk-!-margin-bottom-3 permit-header-actions">
      <h1 class="govuk-heading-l govuk-!-margin-bottom-0">{{ permit }}</h1>
      {{ govukButton({ text: "View permit PDF", href: "#", classes: "govuk-button--secondary" }) }}
    </div>

    <h2 class="govuk-heading-s">Permit details</h2>
    <div class="govuk-grid-row govuk-!-margin-bottom-3 permit-summary-16px permit-info-compare summary-list-stacked">
      <div class="govuk-grid-column-one-half">
        {{ govukSummaryList({
          rows: [
            { key: { text: "Permit status" }, value: { html: "<strong class=\"govuk-tag govuk-tag--blue\">Valid</strong>" } },
            { key: { text: "Exporter/re-exporter" }, value: { html: "Montreval Cuir SA<br>Rue du Marché 18 1204<br>Geneva<br>Switzerland" } },
            { key: { text: "Source" }, value: { text: "C: Animals bred in captivity" } },
            { key: { text: "Appendix/Annex" }, value: { text: "I / A" } }
          ]
        }) }}
      </div>
      <div class="govuk-grid-column-one-half">
        {{ govukSummaryList({
          rows: [
            { key: { text: "Type" }, value: { text: "Import" } },
            { key: { text: "Importer" }, value: { html: "Stratford & Hale Watch Company Ltd<br>Unit 14 Hatton Garden Business Centre<br>London<br>EC1N 8DL" } },
            { key: { text: "Purpose" }, value: { text: "T: Commercial" } },
            { key: { text: "Last day of validity" }, value: { text: expires } }
          ]
        }) }}
      </div>
    </div>

    <h2 class="govuk-heading-s">Specimen details</h2>
    <div class="govuk-grid-row govuk-!-margin-bottom-3 permit-summary-16px summary-list-stacked">
      <div class="govuk-grid-column-one-half">
        {{ govukSummaryList({
          rows: [
            { key: { text: "Scientific name" }, value: { text: species } },
            { key: { text: "Description" }, value: { text: description } }
          ]
        }) }}
      </div>
      <div class="govuk-grid-column-one-half">
        {{ govukSummaryList({
          rows: [
            { key: { text: "Common name" }, value: { text: commonName } },
            { key: { text: "Quantity" }, value: { text: quantity } }
          ]
        }) }}
      </div>
    </div>

    <h2 class="govuk-heading-s">Endorse permit</h2>
    <form method="post" action="/alpha-02-03-26/single-search-results/check-permit-details" autocomplete="off">
      <input type="hidden" name="permit" value="{{ permit }}" />
      <div class="govuk-form-group">
        <label class="govuk-label" for="actualQuantity">Actual quantity</label>
        <input class="govuk-input govuk-input--width-5" id="actualQuantity" name="actualQuantity" type="text" inputmode="numeric" value="">
        <p class="govuk-hint govuk-!-margin-top-1">
          <a href="#" class="govuk-link govuk-link--no-visited-state endorsement-form-action" id="useSpecimenQuantityLink" data-quantity="{{ quantity or '80' }}">Use specimen quantity</a>
        </p>
      </div>
      <div class="govuk-form-group">
        <label class="govuk-label" for="mrnReference">Customs document reference</label>
        <input class="govuk-input govuk-input--width-20" id="mrnReference" name="mrnReference" type="text" value="{{ (data and data.endorsedDetails and data.endorsedDetails[permit] and data.endorsedDetails[permit].mrnReference) or (data and data.mrnReference) or '' }}" aria-describedby="mrnReference-apply-hint">
        <p class="govuk-hint govuk-!-margin-top-2 customs-reference-actions">
          <span id="mrnReference-apply-hint" aria-live="polite"></span>
          <a href="#" class="govuk-link govuk-link--no-visited-state endorsement-form-action govuk-!-display-block govuk-!-margin-top-1" id="applyReferenceLink" data-permit="{{ permit }}">Apply reference to all permits</a>
        </p>
      </div>
      <div class="govuk-button-group govuk-!-margin-top-4">
        {{ govukButton({ text: "Endorse permit", name: "endorse", value: "Endorse permit", type: "submit" }) }}
        {{ govukButton({ text: "Refuse endorsement", name: "refuse", value: "Refuse endorsement", type: "submit", classes: "govuk-button--secondary" }) }}
      </div>
    </form>
  </div>
</div>
