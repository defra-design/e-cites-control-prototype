{# Generated by Cursor - smooth close animation for notification banners (no reload, no jump) #}
<script>
(function () {
  'use strict'
  document.querySelectorAll('[data-close-banner]').forEach(function (link) {
    link.addEventListener('click', function (e) {
      e.preventDefault()
      var banner = link.closest('.govuk-notification-banner[data-dismissable]')
      var href = link.getAttribute('href')
      if (!banner || !href) return
      var urlWithoutHash = href.split('#')[0]
      banner.classList.add('govuk-notification-banner--closing')
      setTimeout(function () {
        banner.remove()
        if (window.history && window.history.replaceState) {
          window.history.replaceState(null, '', urlWithoutHash)
        }
      }, 350)
    })
  })
})()
</script>
