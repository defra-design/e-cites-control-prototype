{# Generated by Cursor - shared content for permit pages #}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    <span class="govuk-caption-l">Permit reference {{ permit }}</span>
    <div class="govuk-!-margin-bottom-3 permit-header-actions">
      <h1 class="govuk-heading-l govuk-!-margin-bottom-0">Check permit details</h1>
      {{ govukButton({ text: "View permit PDF", href: "/public/documents/" ~ permit ~ ".pdf", classes: "govuk-button--secondary", attributes: { target: "_blank", rel: "noopener noreferrer" } }) }}
    </div>

    <h2 class="govuk-heading-s">Permit summary</h2>
    <div class="govuk-grid-row govuk-!-margin-bottom-3 permit-summary-16px permit-info-compare summary-list-stacked">
      <div class="govuk-grid-column-one-half">
        {{ govukSummaryList({
          rows: [
            { key: { text: "Status" }, value: { html: "<strong class=\"govuk-tag " ~ (validityTagClass | default("govuk-tag--blue")) ~ "\">" ~ (validityTag | default("Valid")) ~ "</strong>" } },
            { key: { text: "Exporter/re-exporter" }, value: { html: "Montreval Cuir SA<br>Rue du Marché 18, 1204<br>Geneva<br>Switzerland" } },
            { key: { text: "Issue date" }, value: { text: issueDate | default("8 September 2025") } },
            { key: { text: "Scientific name" }, value: { text: species | default("Alligator mississippiensis") } },
            { key: { text: "Description" }, value: { text: description | default("Watch straps made of alligator skin") } }
          ]
        }) }}
      </div>
      <div class="govuk-grid-column-one-half">
        {{ govukSummaryList({
          rows: [
            { key: { text: "Type" }, value: { text: "Import" } },
            { key: { text: "Importer" }, value: { html: "Stratford & Hale Watch Company Ltd<br>Unit 14 Hatton Garden Business Centre<br>London<br>EC1N 8DL" } },
            { key: { text: "Expiry date" }, value: { text: expires | default("8 March 2026") } },
            { key: { text: "Common name" }, value: { text: commonName | default("American alligator") } },
            { key: { text: "Quantity" }, value: { text: quantity | default("20") } }
          ]
        }) }}
      </div>
    </div>

    <h2 class="govuk-heading-s">Endorse permit</h2>
    <form method="post" action="/alpha-18-03-26/single-search-results/check-permit-details" autocomplete="off">
      <input type="hidden" name="permit" value="{{ permit }}" />
      <div class="govuk-form-group">
        <label class="govuk-label" for="actualQuantity">Quantity</label>
        <input class="govuk-input govuk-input--width-5" id="actualQuantity" name="actualQuantity" type="text" inputmode="numeric" value="">
        <p class="govuk-hint govuk-!-margin-top-1">
          <a href="#" class="govuk-link govuk-link--no-visited-state endorsement-form-action" id="useSpecimenQuantityLink" data-quantity="{{ quantity or '20' }}">Enter quantity shown on permit</a>
        </p>
      </div>
      <div class="govuk-form-group">
        <label class="govuk-label" for="mrnReference">Customs document reference</label>
        <input class="govuk-input govuk-input--width-20" id="mrnReference" name="mrnReference" type="text" value="{{ (data and data.endorsedDetails and data.endorsedDetails[permit] and data.endorsedDetails[permit].mrnReference) or (data and data.mrnReference) or '' }}" aria-describedby="mrnReference-apply-hint">
        <p class="govuk-hint govuk-!-margin-top-2 customs-reference-actions">
          <span id="mrnReference-apply-hint" aria-live="polite"></span>
          <span class="customs-reference-link-wrap">
            <a href="#" class="govuk-link govuk-link--no-visited-state endorsement-form-action" id="applyReferenceLink" data-permit="{{ permit }}">Apply this reference to all permits in this consignment</a>
          </span>
        </p>
      </div>
      <div class="govuk-button-group govuk-!-margin-top-4">
        {{ govukButton({ text: "Endorse permit", name: "endorse", value: "Endorse permit", type: "submit" }) }}
        {{ govukButton({ text: "Refuse endorsement", name: "refuse", value: "Refuse endorsement", type: "submit", classes: "govuk-button--secondary" }) }}
      </div>
    </form>
  </div>
</div>
