{# Generated by Cursor - batch version, applies MRN to batch check-permit-details #}
<script>
(function () {
  'use strict'
  var actualQuantityInput = document.getElementById('actualQuantity')
  var useSpecimenLink = document.getElementById('useSpecimenQuantityLink')
  var mrnInput = document.getElementById('mrnReference')
  var applyLink = document.getElementById('applyReferenceLink')
  var hint = document.getElementById('mrnReference-apply-hint')
  if (!mrnInput) return

  if (useSpecimenLink && actualQuantityInput) {
    useSpecimenLink.addEventListener('click', function (e) {
      e.preventDefault()
      var qty = useSpecimenLink.getAttribute('data-quantity') || ''
      if (qty) {
        actualQuantityInput.value = qty
        useSpecimenLink.blur()
      }
    })
  }

  if (applyLink) {
    applyLink.addEventListener('click', function (e) {
      e.preventDefault()
      e.stopPropagation()
      var value = mrnInput.value
      if (!value) {
        if (hint) hint.textContent = 'Enter a customs document reference first'
        return
      }
      if (hint) hint.textContent = 'Applying…'
      var base = '/beta-16-04-26/batch-search-results/check-permit-details'
      var permit = applyLink.getAttribute('data-permit') || ''
      var url = base + '?permit=' + encodeURIComponent(permit) + '&applyReference=1&mrnReference=' + encodeURIComponent(value)
      fetch(url, { redirect: 'manual' }).then(function () {
        if (hint) hint.textContent = 'Applied to all permits'
        applyLink.blur()
      }).catch(function () {
        if (hint) hint.textContent = 'Could not apply. Try again.'
      })
    })
  }
})()
</script>
